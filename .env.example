# Application behavior
TURBOFAN_ENVIRONMENT=development
TURBOFAN_LOG_LEVEL=INFO

# Local PostgreSQL container. Choose a password in your untracked .env file.
POSTGRES_DB=turbofan
POSTGRES_USER=turbofan
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5432

# Keep the password in this URL in sync with POSTGRES_PASSWORD above.
TURBOFAN_DATABASE_URL=postgresql+psycopg://turbofan:replace-with-local-password@localhost:5432/turbofan

# LLM provider (Milestone 5). Create a key at https://platform.openai.com/api-keys
# The real value goes ONLY in your untracked .env file, never in this template.
TURBOFAN_OPENAI_API_KEY=replace-with-your-openai-key

# The key callers send in the X-API-Key header to use /v1/query, /v1/query/stream,
# and /v1/feedback. Without one those endpoints answer 503: they are closed by
# default, never open. Use a long random value, for example the output of
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TURBOFAN_QUERY_API_KEY=replace-with-a-long-random-string

# Where the BGE embedding weights live. Leave unset for a source checkout: the
# default is this repository's data/processed/models. The container image sets
# it to /opt/models, where the weights are baked in at build time.
# TURBOFAN_MODEL_CACHE_DIR=/opt/models

# Host port for the containerised API (compose only; the container listens on
# 8000 internally).
# TURBOFAN_API_PORT=8000
