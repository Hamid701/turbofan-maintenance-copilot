# Application behavior
TURBOFAN_ENVIRONMENT=development
TURBOFAN_LOG_LEVEL=INFO

# Local PostgreSQL container. Replace the placeholder in your untracked .env file.
POSTGRES_DB=turbofan
POSTGRES_USER=turbofan
POSTGRES_PASSWORD=redacted-local-dev-password
POSTGRES_PORT=5432

# Keep these credentials synchronized with the PostgreSQL values above.
TURBOFAN_DATABASE_URL=postgresql+psycopg://turbofan:redacted-local-dev-password@localhost:5432/turbofan
