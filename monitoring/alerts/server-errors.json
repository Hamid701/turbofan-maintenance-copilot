{
  "displayName": "Turbofan copilot: server errors",
  "documentation": {
    "content": "Cloud Run returned 5xx responses. This covers failures that never reached the application, such as the container failing to start or a request timing out, which the query events cannot show.",
    "mimeType": "text/markdown"
  },
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "5xx responses in the last 5 minutes",
      "conditionThreshold": {
        "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\" resource.label.service_name=\"turbofan-copilot\" metric.label.response_code_class=\"5xx\"",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_DELTA",
            "crossSeriesReducer": "REDUCE_SUM",
            "groupByFields": []
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 0,
        "duration": "0s",
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "notificationChannels": ["CHANNEL"],
  "alertStrategy": {
    "autoClose": "3600s"
  }
}
